{
  "name": "github-pr-review",
  "description": "Review a pull request for architecture, security, performance, and TODO/docs sync.",
  "event": "github.pull_request.opened_or_synchronize",
  "enabled": true,
  "workflow": "../workflows/review-and-sync.workflow.md",
  "workflowRef": "workflows/review-and-sync.workflow.md",
  "skills": [
    "../skills/00-architecture-planning.skill.md",
    "../skills/05-agent-tools-context.skill.md",
    "../skills/07-ai-gateway-security.skill.md",
    "../skills/08-review-audit.skill.md"
  ],
  "skillRefs": [
    "skills/00-architecture-planning.skill.md",
    "skills/05-agent-tools-context.skill.md",
    "skills/07-ai-gateway-security.skill.md",
    "skills/08-review-audit.skill.md"
  ],
  "rules": [
    "../rules/00-project-context.md",
    "../rules/01-architecture-guardrails.md",
    "../rules/03-security-and-permissions.md",
    "../rules/04-performance-dx.md",
    "../rules/05-docs-and-todo-sync.md"
  ],
  "ruleRefs": [
    "rules/00-project-context.md",
    "rules/01-architecture-guardrails.md",
    "rules/03-security-and-permissions.md",
    "rules/04-performance-dx.md",
    "rules/05-docs-and-todo-sync.md"
  ],
  "mode": "review",
  "inputs": {
    "pullRequestTitle": "{{github.pull_request.title}}",
    "pullRequestBody": "{{github.pull_request.body}}",
    "baseRef": "{{github.pull_request.base.ref}}",
    "headRef": "{{github.pull_request.head.ref}}"
  },
  "requiredContext": [
    "ARCHITECTURE.md",
    "TODO.md",
    ".clinerules",
    ".cline/manifest.json"
  ],
  "linkedResources": {
    "workflow": "workflows/review-and-sync.workflow.md",
    "skills": [
      "skills/00-architecture-planning.skill.md",
      "skills/05-agent-tools-context.skill.md",
      "skills/07-ai-gateway-security.skill.md",
      "skills/08-review-audit.skill.md"
    ],
    "rules": [
      "rules/00-project-context.md",
      "rules/01-architecture-guardrails.md",
      "rules/03-security-and-permissions.md",
      "rules/04-performance-dx.md",
      "rules/05-docs-and-todo-sync.md"
    ]
  },
  "guardrails": [
    "Do not apply fixes automatically.",
    "Flag direct module coupling.",
    "Flag unsafe secret, token, terminal, browser, or scratchpad behavior."
  ]
}
