{
  "name": "ci-failure-fix",
  "description": "Analyze CI failures and propose a safe fix plan before changes.",
  "event": "ci.workflow.failed",
  "enabled": true,
  "workflow": "../workflows/review-and-sync.workflow.md",
  "workflowRef": "workflows/review-and-sync.workflow.md",
  "skills": [
    "../skills/03-terminal-runtime.skill.md",
    "../skills/05-agent-tools-context.skill.md",
    "../skills/07-ai-gateway-security.skill.md",
    "../skills/08-review-audit.skill.md"
  ],
  "skillRefs": [
    "skills/03-terminal-runtime.skill.md",
    "skills/05-agent-tools-context.skill.md",
    "skills/07-ai-gateway-security.skill.md",
    "skills/08-review-audit.skill.md"
  ],
  "rules": [
    "../rules/00-project-context.md",
    "../rules/02-operating-protocol.md",
    "../rules/03-security-and-permissions.md",
    "../rules/05-docs-and-todo-sync.md"
  ],
  "ruleRefs": [
    "rules/00-project-context.md",
    "rules/02-operating-protocol.md",
    "rules/03-security-and-permissions.md",
    "rules/05-docs-and-todo-sync.md"
  ],
  "mode": "plan_then_act",
  "inputs": {
    "workflowName": "{{ci.workflow.name}}",
    "jobName": "{{ci.job.name}}",
    "failureLog": "{{ci.job.failure_log}}",
    "commitSha": "{{ci.commit.sha}}"
  },
  "requiredContext": [
    "ARCHITECTURE.md",
    "TODO.md",
    ".clinerules",
    ".cline/manifest.json"
  ],
  "linkedResources": {
    "workflow": "workflows/review-and-sync.workflow.md",
    "skills": [
      "skills/03-terminal-runtime.skill.md",
      "skills/05-agent-tools-context.skill.md",
      "skills/07-ai-gateway-security.skill.md",
      "skills/08-review-audit.skill.md"
    ],
    "rules": [
      "rules/00-project-context.md",
      "rules/02-operating-protocol.md",
      "rules/03-security-and-permissions.md",
      "rules/05-docs-and-todo-sync.md"
    ]
  },
  "guardrails": [
    "Summarize logs before using them as agent context.",
    "Do not access secrets from CI logs.",
    "Prefer minimal patches and run validation after fixes."
  ]
}
