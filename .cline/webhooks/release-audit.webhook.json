{
  "name": "release-audit",
  "description": "Run a release readiness audit focused on architecture, security, performance, and documentation consistency.",
  "event": "release.before_publish",
  "enabled": true,
  "workflow": "../workflows/review-and-sync.workflow.md",
  "workflowRef": "workflows/review-and-sync.workflow.md",
  "skills": [
    "../skills/00-architecture-planning.skill.md",
    "../skills/02-performance-startup.skill.md",
    "../skills/07-ai-gateway-security.skill.md",
    "../skills/08-review-audit.skill.md"
  ],
  "skillRefs": [
    "skills/00-architecture-planning.skill.md",
    "skills/02-performance-startup.skill.md",
    "skills/07-ai-gateway-security.skill.md",
    "skills/08-review-audit.skill.md"
  ],
  "rules": [
    "../rules/00-project-context.md",
    "../rules/01-architecture-guardrails.md",
    "../rules/03-security-and-permissions.md",
    "../rules/04-performance-dx.md",
    "../rules/05-docs-and-todo-sync.md"
  ],
  "ruleRefs": [
    "rules/00-project-context.md",
    "rules/01-architecture-guardrails.md",
    "rules/03-security-and-permissions.md",
    "rules/04-performance-dx.md",
    "rules/05-docs-and-todo-sync.md"
  ],
  "mode": "review",
  "inputs": {
    "version": "{{release.version}}",
    "tag": "{{release.tag}}",
    "changelog": "{{release.changelog}}"
  },
  "requiredContext": [
    "ARCHITECTURE.md",
    "TODO.md",
    ".clinerules",
    ".cline/manifest.json"
  ],
  "linkedResources": {
    "workflow": "workflows/review-and-sync.workflow.md",
    "skills": [
      "skills/00-architecture-planning.skill.md",
      "skills/02-performance-startup.skill.md",
      "skills/07-ai-gateway-security.skill.md",
      "skills/08-review-audit.skill.md"
    ],
    "rules": [
      "rules/00-project-context.md",
      "rules/01-architecture-guardrails.md",
      "rules/03-security-and-permissions.md",
      "rules/04-performance-dx.md",
      "rules/05-docs-and-todo-sync.md"
    ]
  },
  "guardrails": [
    "Check secret handling and token vault boundaries.",
    "Check audit logging and permission model changes.",
    "Check performance/startup regressions.",
    "Check TODO and documentation consistency."
  ]
}
