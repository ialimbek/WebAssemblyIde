{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./",
    "composite": true,
    "isolatedModules": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true
  },
  "exclude": ["node_modules", "dist", "crates", "services", "apps"],
  "references": [
    { "path": "packages/shared" },
    { "path": "packages/command-bus" },
    { "path": "packages/performance-core" },
    { "path": "packages/settings" },
    { "path": "packages/notifications" },
    { "path": "packages/ide-core" },
    { "path": "packages/ui" },
    { "path": "packages/agent-runtime" },
    { "path": "packages/editor" }
  ]
}
