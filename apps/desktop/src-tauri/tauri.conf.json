{
  "$schema": "../../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "WebAssemblyIde",
  "version": "0.3.0",
  "identifier": "com.webassembly-ide.desktop",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm --prefix ../web run build"
  },
  "app": {
    "windows": [
      {
        "title": "WebAssemblyIde",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "trayIcon": {
      "iconPath": "icons/128x128.png",
      "iconAsTemplate": true,
      "title": "WebAssemblyIde",
      "tooltip": "WebAssemblyIde"
    },
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://releases.webassembly-ide.local/{{target}}/{{arch}}/{{current_version}}"
      ],
      "dialog": true,
      "pubkey": "REPLACE_WITH_RELEASE_PUBKEY_BEFORE_SHIPPING"
    }
  }
}
