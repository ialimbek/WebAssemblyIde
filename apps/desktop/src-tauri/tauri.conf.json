{
  "$schema": "../../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "WebAssemblyIde",
  "version": "0.1.0",
  "identifier": "com.webassembly-ide.desktop",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev --workspace=@webassembly-ide/web",
    "beforeBuildCommand": "npm run build --workspace=@webassembly-ide/web"
  },
  "app": {
    "windows": [
      {
        "title": "WebAssemblyIde",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
