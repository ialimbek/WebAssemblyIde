{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability surface for WebAssemblyIde desktop. Grants the minimum set of Tauri plug-in permissions needed by the IDE's web frontend.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:tray:default",
    "core:menu:default",
    "core:window:default",
    "core:webview:default",
    "core:event:default",
    "core:path:default",
    "core:resources:default",
    "updater:default",
    "log:default",
    "notification:default",
    "dialog:default",
    "clipboard-manager:default"
  ]
}
